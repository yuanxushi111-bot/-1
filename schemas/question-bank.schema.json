{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question bank v1",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "source_type", "questions"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["past_exam", "textbook", "mock", "custom", "ai_generated"]},
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["id", "stem", "subject", "kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "stem": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "kind": {"enum": ["名词解释", "简答", "论述", "案例", "计算", "选择", "其他"]},
          "context": {"type": "string"},
          "year": {"type": "integer", "minimum": 1900, "maximum": 2200},
          "knowledge_points": {"type": "array", "items": {"type": "string"}},
          "completeness": {"enum": ["complete", "partial"]},
          "answer": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["text", "status"], "properties": {"text": {"type": "string"}, "status": {"type": "string", "minLength": 1}}}]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["block_id", "quote"], "properties": {"block_id": {"type": "string"}, "quote": {"type": "string", "minLength": 1}}}}
        }
      }
    }
  },
  "allOf": [{"if": {"properties": {"source_type": {"const": "ai_generated"}}}, "then": {"properties": {"questions": {"items": {"required": ["evidence"], "not": {"required": ["year"]}}}}}}]
}
